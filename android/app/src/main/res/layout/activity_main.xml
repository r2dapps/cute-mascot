<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_screen"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- Header with icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@mipmap/ic_launcher"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/app_name"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cute Mascot"
                    android:textColor="@color/textPrimary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"/>

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorPrimary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Floating companion · alarms · voice notes"
            android:textColor="@color/textSecondary"
            android:textSize="13sp"
            android:layout_marginBottom="16dp"/>

        <!-- Active Alarm Notification Bar (visible only when an alarm is sounding) -->
        <LinearLayout
            android:id="@+id/cardActiveAlarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvActiveAlarmTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⏰ Reminder Ringing!"
                android:textColor="@color/accent"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvActiveAlarmSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap below or tap the floating mascot to stop"
                android:textColor="@color/textSecondary"
                android:textSize="13sp"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStopAlarmMain"
                    style="@style/Widget.CuteMascot.Button"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="46dp"
                    android:text="⏹ Stop Alarm"
                    android:layout_marginEnd="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSnoozeAlarmMain"
                    style="@style/Widget.CuteMascot.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="46dp"
                    android:text="💤 Snooze"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ===== PERMISSIONS & SETUP GUIDE ===== -->
        <LinearLayout
            android:id="@+id/cardPermissionGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/headerPermissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔒 Android Permissions &amp; Setup"
                    style="@style/Text.CuteMascot.Section"
                    android:textColor="@color/accent"/>

                <TextView
                    android:id="@+id/chevronPermissions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▾"
                    android:textColor="@color/textMuted"
                    android:textSize="16sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bodyPermissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="If Android blocks permissions as 'Restricted setting':\n1️⃣ Tap Step 1 to open App Info\n2️⃣ Tap the 3 dots (⋮) in the top-right corner\n3️⃣ Tap 'Allow restricted settings' and enter PIN\n4️⃣ Grant Display Over Apps, Alarms &amp; Notifications below."
                    style="@style/Text.CuteMascot.Hint"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="12dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStep1"
                    style="@style/Widget.CuteMascot.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1 · Open App Info (⋮ Allow restricted)"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStep2"
                    style="@style/Widget.CuteMascot.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2 · Allow Display Over Apps"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStepAlarmPermission"
                    style="@style/Widget.CuteMascot.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3 · Allow Alarms &amp; Reminders"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStepNotifPermission"
                    style="@style/Widget.CuteMascot.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4 · Allow Notifications"/>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/show_mascot"
            android:textSize="15sp"
            android:layout_marginBottom="14dp"/>

        <!-- ===== SIZE (collapsible) ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:id="@+id/headerSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/section_size"
                    style="@style/Text.CuteMascot.Section"/>

                <TextView
                    android:id="@+id/tvSizeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorPrimary"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/chevronSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▾"
                    android:textColor="@color/textMuted"
                    android:textSize="16sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bodySize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <SeekBar
                    android:id="@+id/seekSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="160"
                    android:progress="60"
                    android:progressTint="@color/colorPrimary"
                    android:thumbTint="@color/colorPrimary"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSize100"
                        style="@style/Widget.CuteMascot.Button.Chip"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Mini" android:layout_marginEnd="6dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSize140"
                        style="@style/Widget.CuteMascot.Button.Chip"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Small" android:layout_marginEnd="6dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSize180"
                        style="@style/Widget.CuteMascot.Button.Chip"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Med"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSize220"
                        style="@style/Widget.CuteMascot.Button.Chip"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Large" android:layout_marginEnd="6dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSize260"
                        style="@style/Widget.CuteMascot.Button.Chip"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Jumbo"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ===== CHARACTER (collapsible, expanded by default) ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:id="@+id/headerSkin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/section_skin"
                    style="@style/Text.CuteMascot.Section"/>

                <TextView
                    android:id="@+id/chevronSkin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▾"
                    android:textColor="@color/textMuted"
                    android:textSize="16sp"/>
            </LinearLayout>

            <GridLayout
                android:id="@+id/bodySkin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="true"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="14dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAIPrompts"
                    style="@style/Widget.CuteMascot.Button.Chip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="🎨 AI Prompts"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImportCharacter"
                    style="@style/Widget.CuteMascot.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="✨ Import PNG"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ===== TRACKING (collapsible) ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:id="@+id/headerTrack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/section_tracking"
                    style="@style/Text.CuteMascot.Section"/>

                <TextView
                    android:id="@+id/chevronTrack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▾"
                    android:textColor="@color/textMuted"
                    android:textSize="16sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bodyTrack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/track_hint"
                    style="@style/Text.CuteMascot.Hint"
                    android:layout_marginBottom="8dp"/>

                <RadioGroup
                    android:id="@+id/rgTracking"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp">
                    <RadioButton
                        android:id="@+id/rbTrackTouch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/track_touch"
                        android:textColor="@color/textPrimary"
                        android:buttonTint="@color/accentMint"
                        android:minHeight="40dp"/>
                    <RadioButton
                        android:id="@+id/rbTrackGyro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/track_gyro"
                        android:textColor="@color/textPrimary"
                        android:buttonTint="@color/accentMint"
                        android:minHeight="40dp"/>
                </RadioGroup>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchInvertGyro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Invert gyro direction"
                    android:textColor="@color/textPrimary"
                    android:layout_marginBottom="10dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/outline"
                    android:layout_marginBottom="10dp"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchSound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Boop sounds"
                    android:textColor="@color/textPrimary"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestSound"
                    style="@style/Widget.CuteMascot.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Test boop"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ===== ALARMS (collapsible, expanded) ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:id="@+id/headerAlarms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Alarms"
                    style="@style/Text.CuteMascot.Section"/>

                <TextView
                    android:id="@+id/chevronAlarms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▾"
                    android:textColor="@color/textMuted"
                    android:textSize="16sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bodyAlarms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/reminders_hint"
                    style="@style/Text.CuteMascot.Hint"
                    android:layout_marginBottom="8dp"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchReminders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enable alarms"
                    android:textColor="@color/textPrimary"
                    android:layout_marginBottom="8dp"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch24Hour"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="24-hour format (off = 12h AM/PM)"
                    android:textColor="@color/textPrimary"
                    android:layout_marginBottom="8dp"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchVoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_enabled"
                    android:textColor="@color/textPrimary"
                    android:layout_marginBottom="8dp"/>

                <RadioGroup
                    android:id="@+id/rgVoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <!-- Female voices -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="♀ Female voices"
                        android:textColor="@color/accent"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingTop="4dp"
                        android:paddingBottom="2dp"/>
                    <RadioButton
                        android:id="@+id/rbVoiceGodavari"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🌸 Godavari Telugu (female)"
                        android:textColor="@color/textPrimary"
                        android:buttonTint="@color/colorPrimary"
                        android:minHeight="36dp"/>
                    <RadioButton
                        android:id="@+id/rbVoiceJapanese"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🌸 Japanese anime (female)"
                        android:textColor="@color/textPrimary"
                        android:buttonTint="@color/colorPrimary"
                        android:minHeight="36dp"/>

                    <!-- Male voices -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="♂ Male voices"
                        android:textColor="@color/accent"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingTop="8dp"
                        android:paddingBottom="2dp"/>
                    <RadioButton
                        android:id="@+id/rbVoiceGodavariMale"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🎙️ Andhra Telugu (male)"
                        android:textColor="@color/textPrimary"
                        android:buttonTint="@color/colorPrimary"
                        android:minHeight="36dp"/>
                    <RadioButton
                        android:id="@+id/rbVoiceJapaneseMale"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🎙️ Japanese cool (male)"
                        android:textColor="@color/textPrimary"
                        android:buttonTint="@color/colorPrimary"
                        android:minHeight="36dp"/>
                </RadioGroup>

                <LinearLayout
                    android:id="@+id/listAlarms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="10dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddAlarm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Add alarm"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImportVoiceMain"
                    style="@style/Widget.CuteMascot.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Import voice note"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestVoice"
                    style="@style/Widget.CuteMascot.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Test voice"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Credits & Inspiration Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💖 Built with love"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Special thanks to nilbuild/page-mascot for inspiring this project and the cursor tracking math! Built to bring delight every day."
                android:textColor="@color/textSecondary"
                android:textSize="12sp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenCredits"
                style="@style/Widget.CuteMascot.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="⭐ View nilbuild/page-mascot on GitHub"
                android:textSize="12sp"
                android:textColor="@color/accent"
                android:textAllCaps="false"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cute Desktop Mascot · v1.4.0"
                android:textColor="@color/textMuted"
                android:textSize="11sp"
                android:layout_marginTop="10dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
